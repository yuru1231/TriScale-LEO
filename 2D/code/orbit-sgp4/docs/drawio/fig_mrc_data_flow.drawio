<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="MRC Combining Data Flow" id="mrc-flow">
    <mxGraphModel dx="800" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="780" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- RunPhase Background -->
        <mxCell id="n01" value="Simulator::Run() — all qualifying satellites fire concurrently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1976d2;verticalAlign=top;spacingTop=6;fontStyle=1;fontSize=12;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="700" height="140" as="geometry"/>
        </mxCell>

        <!-- CB1 -->
        <mxCell id="n02" value="ScanSnrCallback(sat_11, t)&lt;br&gt;results: 25 cells" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="185" height="70" as="geometry"/>
        </mxCell>

        <!-- CB2 -->
        <mxCell id="n03" value="ScanSnrCallback(sat_52, t)&lt;br&gt;results: 25 cells" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="278" y="60" width="185" height="70" as="geometry"/>
        </mxCell>

        <!-- CB3 -->
        <mxCell id="n04" value="ScanSnrCallback(sat_53, t)&lt;br&gt;results: 25 cells" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="496" y="60" width="185" height="70" as="geometry"/>
        </mxCell>

        <!-- Accum -->
        <mxCell id="n05" value="timeKey = round(t × 10)&lt;br&gt;for cell i:&lt;br&gt;  linearSnrSum += 10^(snr_dB/10)&lt;br&gt;  nSats += 1&lt;br&gt;→ MrcAccumulator (shared)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="230" width="370" height="100" as="geometry"/>
        </mxCell>

        <!-- WriteMrc -->
        <mxCell id="n06" value="WriteMrcCsv() after Simulator::Destroy()&lt;br&gt;for each (timeKey, cellVec):&lt;br&gt;  snr_mrc_dB = 10 * log10(linearSnrSum)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="400" width="370" height="80" as="geometry"/>
        </mxCell>

        <!-- Output -->
        <mxCell id="n07" value="mrc_combined.csv&lt;br&gt;time_s, cell_idx, snr_mrc_dB, n_sats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="550" width="370" height="70" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e01" edge="1" source="n02" target="n05" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e02" edge="1" source="n03" target="n05" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e03" edge="1" source="n04" target="n05" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e04" edge="1" source="n05" target="n06" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e05" edge="1" source="n06" target="n07" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
