                <mxCell id="B3" value="For t = winStart to winEnd, step dtSnrS&#xa;Simulator::Schedule(Seconds(t), ScanSnrCallback, state, t)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="370" y="1300" width="320" height="65" as="geometry"/>
