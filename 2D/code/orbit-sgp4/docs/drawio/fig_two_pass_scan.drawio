                    <mxGeometry x="420" y="1115" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="B2" value="Allocate SatScanState (heap)&#xa;Open sat_XXXXX_cells.csv&#xa;Write CSV header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
