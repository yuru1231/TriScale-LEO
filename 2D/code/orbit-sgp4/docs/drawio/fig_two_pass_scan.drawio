    <diagram name="Two-Pass Scan" id="scan-01">
        <mxGraphModel dx="1760" dy="998" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="orbit-sgp4 — Two-Pass Constellation Scan Algorithm" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="20" width="900" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="S" value="START&#xa;ConstellationScanConfig" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="430" y="70" width="200" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="A1" value="SatTleReader::Load()&#xa;Parse tles.txt + fwdConf.txt&#xa;Initialize SGP4 (66 x elsetrec)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="155" width="280" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="A2" value="Compute observer ECEF&#xa;obsEcef = rEarth x {cos(lat)cos(lon), cos(lat)sin(lon), sin(lat)}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="250" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="PA_HDR" value="PASS A — Coarse Elevation Screen (Pure C++)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="340" width="860" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="A3" value="For each satellite i in 1..66" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="420" y="395" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="A4" value="For t = 0 to windowS, step dtScreenS&#xa;(default: t = 0, 10, 20, ... 3600 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="485" width="280" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="A5" value="ComputeElevation(sat, t/60, epochJd, lat, lon, rEarth)&#xa;(1) sgp4(satrec, t/60) -&gt; r_eci&#xa;(2) EciToEcef(r_eci, jdNow) -&gt; r_ecef&#xa;(3) EcefOffsetToEnu(delta_r, lat, lon) -&gt; satEnu&#xa;(4) GetElevationAngleDeg_3D(satEnu) -&gt; epsilon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="360" y="570" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="A6" value="epsilon &gt;= minElevDeg?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="430" y="700" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="A7" value="if winStart &lt; 0: winStart = t&#xa;winEnd = t&#xa;if epsilon &gt; peakElev: peakElev = epsilon, peakT = t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="660" y="695" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="A8" value="All t done?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="430" y="800" width="200" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="A9" value="winStart &gt;= 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="430" y="890" width="200" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="A10" value="Store SatPassInfo&#xa;qualifyingSats.push_back(sat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="660" y="892" width="240" height="50" as="geometry"/>
