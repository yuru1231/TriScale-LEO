                    <mxGeometry x="430" y="975" width="200" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="PB_HDR" value="PASS B — Fine SNR Scan (ns-3 Event Scheduler)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1060" width="860" height="35" as="geometry"/>
