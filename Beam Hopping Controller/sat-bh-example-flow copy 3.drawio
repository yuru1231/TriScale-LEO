                </mxCell>
                <mxCell id="P3_leg3" value="(empty = beam inactive this slot)" style="text;html=1;fontSize=10;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="690" y="478" width="220" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="P3_obc_note" value="SatBhObc state machine per slot:&#xa;  → ACTIVE (EnterSlot, BeamActivateCallback)&#xa;  → T_sw switching dead-time (no data TX)&#xa;  → ACTIVE next slot / WAIT_PLAN if last slot" style="text;html=1;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="200" y="510" width="440" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="P3_em_note" value="SatBhScheduler every T_p:&#xa;  1. RunEM() → λ_n (Poisson rate) per beam&#xa;  2. ComputeSlotAllocation() → d_n (slot count, Σd_n=M×K)&#xa;  3. ComputeVirtualTraffic() → A_n (delay-weighted)&#xa;  4. BuildPlan(): hotspot (A_n high) → Phase B packing&#xa;                non-hotspot (A_n low) → Phase A greedy" style="text;html=1;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="660" y="510" width="480" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>