                </mxCell>
                <mxCell id="IH" value="ApplySyntheticDemand()  every T_s&#xa;For each beam b (1..numBeams):&#xa;  base = hotspot?6:2, amp = hotspot?2:0.5&#xa;  phase = b×π/3  (60° offset per beam)&#xa;  demand = base + amp×sin(2π×t/60+phase)&#xa;  Scheduler::OnDemandReceived(beamId, demand)&#xa;SchedulerCycle: ScheduleNextCycle(warmUpSec)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
