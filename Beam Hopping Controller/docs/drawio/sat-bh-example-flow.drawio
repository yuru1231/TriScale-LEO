                <mxCell id="M4" value="Step 3: Traffic Setup&#xa;FWD CBR (hotspot): 20ms / 1500B&#xa;  GwUser→UtUsers, start=warmUpSec&#xa;RTN CBR: 100ms / 512B&#xa;  GwUser→UtUsers, start=warmUpSec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
