                <mxCell id="overlap-note" value="Overlap ≈ 21%" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=3;align=center;fontColor=#059669;" parent="1" vertex="1">
                    <mxGeometry x="839" y="340" width="120" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="answer-box" value="Q: Does the beam stay in the same cell during T_slot?&#xa;A: NO — footprint centre shifts ≈ 450 km (67% of beam diameter).&#xa;    Only ~21% of the original cell is consistently covered across the slot.&#xa;    ∴ Layer 2 beam-hop frame must be ≪ T_slot to maintain per-cell coverage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="615" y="526" width="572" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="overlap-calc" value="Overlap area = 2r²·arccos(d / 2r) − (d/2)·√(4r²−d²)   where r = 335 km, d = 450 km  →  ≈ 21% of circle area" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;align=center;fontColor=#64748b;" parent="1" vertex="1">
                    <mxGeometry x="615" y="612" width="572" height="18" as="geometry"/>
                </mxCell>
