                <mxCell id="s4-desc" value="Full orbit; ~10 routing slots per pass over a ground area" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=left;fontColor=#a16207;" parent="1" vertex="1">
                    <mxGeometry x="1225" y="454" width="400" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="implication" value="Design implication for Layer 2:&#xa;Beam hop frame (~1–5 s) ≪ T_slot (60 s) — beam can visit multiple cells within&#xa;one routing slot without triggering ISL reroute overhead.&#xa;This decouples coverage adaptation (L2) from routing update cost (L1)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1215" y="510" width="552" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="summary" value="Summary:  T_slot = 60 s  →  50,000 FWD pkts / ISL link / slot,  ~83 concurrent flows.  Beam footprint drifts 450 km (67% of beam width), only 21% overlap.  Layer 2 frame ≪ 60 s required." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#f8fafc;align=center;" parent="1" vertex="1">
                    <mxGeometry x="15" y="860" width="1766" height="36" as="geometry"/>
                </mxCell>
