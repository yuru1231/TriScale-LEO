        <mxCell id="title" value="Figure 5. Iridium-66 ISL Topology Derived from TLE and 132 ISL Pairs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="18" width="980" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="6 orbital planes x 11 satellites per plane; 132 undirected ISLs; degree = 4 per satellite" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#334155;" parent="1" vertex="1"><mxGeometry x="40" y="50" width="980" height="24" as="geometry"/></mxCell>
        <mxCell id="legend" value="Blue: intra-plane ISL&#xa;Green: inter-plane ISL&#xa;Curved edges: wrap-around links&#xa;Topology source: TLE + 132 ISL adjacency pairs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1"><mxGeometry x="40" y="980" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="note" value="Engineering interpretation&#xa;- 6 planes grouped by RAAN = 0, 60, 120, 180, 240, 300 deg&#xa;- Intra-plane links form 6 closed rings&#xa;- Inter-plane links form a wrapped 6 x 11 periodic mesh&#xa;- The supplied ISL file contains no seam cut and no polar disabled region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1"><mxGeometry x="500" y="965" width="780" height="135" as="geometry"/></mxCell>
