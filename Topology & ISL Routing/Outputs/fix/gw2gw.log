# ============================================================
# Run Command & Configuration Reference
# ============================================================
#
# Command:
#   ./ns3 run "scratch/test-iridium \
#     --pathType=gw2gw_e2e \
#     --simTime=180 \
#     --slotInterval=60" \
#     2>&1 | tee e2e/fix/gw2gw_short.log
#
# ------------------------------------------------------------
# Parameter Details
# ------------------------------------------------------------
#
# --pathType=gw2gw_e2e
#   路徑類型：Gateway-to-Gateway 端到端
#   啟用 feeder link（GW→衛星上行）+ ISL（衛星間）+ feeder link（衛星→GW下行）
#   不啟用 service link（衛星→UT）
#   traffic：GW0(JP-Tokyo) → GW1(IN-NewDelhi) 應用層 tagged UDP
#   GW 節點：physical GW node（40.x.x.x），不使用 user node（gwMode 已全面移除）
#
# --simTime=180
#   模擬總時長 180 秒
#   對應 numSlots=4（slot 0=0s, 1=60s, 2=120s, 3=180s）
#   CBR background traffic：1.0s → 179.0s
#   GW2GW application traffic：1.0s → 179.0s
#   選用 180s 理由：足夠覆蓋 3 次 slot 切換（3 個 ROUTE CHANGED 機會），
#                   比 630s 快 ~15x，適合快速驗證路由行為
#
# --slotInterval=60
#   每 60 秒重新計算一次 routing table
#   numSlots = floor(simTime / slotInterval) + 1
#            = floor(180 / 60) + 1 = 4
#   影響：IslRoutingManager 在 t=0, 60, 120, 180 各套用一次路由表
#         每次 HasSignificantChange=YES 會觸發 partial Dijkstra recompute
#
# ------------------------------------------------------------
# 未指定參數（使用預設值）
# ------------------------------------------------------------
#
# --gwSrc=0           GW 來源 preset ID=0（JP-Tokyo，lat=35.68, lon=139.69）
# --gwDst=1           GW 目的 preset ID=1（IN-NewDelhi，lat=28.61, lon=77.21）
# --beamId=72         主 SNS3 beam ID，GW bootstrap beams 自動依 needsGwPair 補充
#                     gw2gw 需要 2 個 GW → enabledBeams={1,2,72}
# --islMaxDistKm=5000 ISL 啟用距離門檻：兩顆衛星距離 ≤5000km 才建立 ISL link
#                     Iridium-66 正常 ISL 約 3900–4800km，此設定涵蓋所有正常連線
# --islRateMbps=10.0  每條 ISL 鏈路頻寬 10 Mbps
# --emaAlpha=0.3      EMA 平滑係數：load-adaptive routing 的 queue delay 平滑權重
#                     alpha=0.3 → 新值佔 30%，歷史值佔 70%，避免抖動
# --changeThresh=0.1  cost 變化超過 10% 才觸發 partial Dijkstra recompute
# --cooldownRatio=0.5 cooldown = slotInterval × 0.5 = 30s，防止路由震盪
# --elevMinDeg=5.0    GW/UT 仰角最低門檻 5 度，仰角不足的衛星不列為 GW entry sat
# --regenerationMode=network
#                     衛星以 network regeneration 模式運作（L3 IP 轉發），
#                     封包在衛星上解包再重新封裝後轉發，非透明轉發
# --islDropThreshPct=1.0
#                     整體 ISL drop rate < 1% → PASS；≥1% → FAIL
#
# ------------------------------------------------------------
# 輸出重導向
# ------------------------------------------------------------
#
# 2>&1              stderr 合併進 stdout（NS-3 abort / 警告訊息一併捕捉）
# tee gw2gw.log     同時輸出到終端機並寫入 log 檔（每次執行覆寫）
#
# ------------------------------------------------------------
# 此指令驗證範圍
# ------------------------------------------------------------
#
# [FEEDER_LAYER]   GW → 衛星 feeder link 上行 / 下行
#                  verdict 目前受 OrbiterRxFeeder callback=0 影響，待查
# [ISL_LAYER]      衛星間 ISL 封包傳輸，drop rate < 1% → PASS
# [SERVICE_LAYER]  不啟用（gw2gw_e2e 無 UT service link）
# [ENDPOINT_PROBE] PacketSink 安裝在 physical GW1（40.67.0.1），
#                  確認封包確實送達目的 GW 的應用層
# ============================================================